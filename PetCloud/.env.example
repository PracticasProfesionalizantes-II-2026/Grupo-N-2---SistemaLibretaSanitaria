# Copiar a .env.local y completar. Este archivo no lleva claves reales.

# Base de datos: Azure Database for PostgreSQL (Flexible Server, PG16).
# Local con docker: postgresql://petcloudadmin:<PASSWORD>@localhost:55432/petcloud
DATABASE_URL=postgresql://petcloudadmin:<PASSWORD>@petcloud-db-grupo2.postgres.database.azure.com:5432/petcloud?sslmode=require

# Auth.js: firma la cookie de sesión. Generar con `npx auth secret` o
# `openssl rand -base64 32`.
AUTH_SECRET=

# Archivos subidos: "local" (carpeta ./.storage) o "azure" (Blob Storage).
STORAGE_DRIVER=local
AZURE_STORAGE_CONNECTION_STRING=

# URL pública del sitio (links en notificaciones y QR).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Geocodificador para el mapa (opcional).
NEXT_PUBLIC_GEOCODER_URL=

# Mercado Pago (suscripción Premium de veterinarias).
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# "true" simula el checkout sin llamar a Mercado Pago.
PREMIUM_CHECKOUT_SIMULADO=true

# Alta del administrador inicial (npm run bootstrap:admin).
ADMIN_OFFICIAL_EMAIL=
ADMIN_PASSWORD=
